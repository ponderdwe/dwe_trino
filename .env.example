# Copy to .env, then generate Trino configs:
#   python3 config_generator.py envs_dev.json --env-file .env
# Then start:
#   docker-compose up -d
#
# Prerequisites: dwe_iceberg_catalog must be running locally first.
# Start it with: cd ../dwe_iceberg_catalog && docker-compose up -d

# Nessie catalog URL — dwe_iceberg_catalog exposes catalog on host port 19120
CATALOG_URL=http://host.docker.internal:19120

# S3-compatible storage for local dev — dwe_iceberg_catalog exposes RustFS on host port 9000
S3_ENDPOINT=http://host.docker.internal:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Trino auth
TRINO_USER=admin
TRINO_PASSWORD=changeme
# generate with: openssl rand -hex 32
TRINO_SHARED_SECRET=dev-shared-secret-replace-in-prod

# ── Production only ────────────────────────────────────────────────────────────

# Iceberg warehouse location (Trino needs this to find data files)
# Azure: abfs://warehouse@<storage_account>.dfs.core.windows.net/
# AWS:   s3://<bucket>/warehouse
ICEBERG_WAREHOUSE_DIR=

# Azure storage (cloud_provider=azure)
AZURE_STORAGE_KEY=

# AWS storage (cloud_provider=aws)
S3_REGION=us-east-1
# S3_ACCESS_KEY and S3_SECRET_KEY above are reused for prod AWS if set

# KG integration (optional)
# KG_API_HOST=
# KG_API_TOKEN=
