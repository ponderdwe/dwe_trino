# Copy to .env, then generate Trino configs:
#   python3 config_generator.py envs_dev.json --env-file .env
# Then start:
#   docker-compose up -d

# Nessie catalog URL
# Local dev: catalog container added by docker-compose.override.yml
CATALOG_URL=http://catalog:19120
# Production: set to your dwe_iceberg_catalog deployment URL
# CATALOG_URL=https://catalog.myorg.com

# RustFS (local dev S3-compatible storage)
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin

# Trino auth
TRINO_USER=admin
TRINO_PASSWORD=changeme
# generate with: openssl rand -hex 32
TRINO_SHARED_SECRET=dev-shared-secret-replace-in-prod

# ── Production only ────────────────────────────────────────────────────────────

# Iceberg warehouse location (Trino needs this to find data files)
# Azure: abfs://warehouse@<storage_account>.dfs.core.windows.net/
# AWS:   s3://<bucket>/warehouse
ICEBERG_WAREHOUSE_DIR=

# Azure storage (cloud_provider=azure)
AZURE_STORAGE_KEY=

# AWS storage (cloud_provider=aws)
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# KG integration (optional)
# KG_API_HOST=
# KG_API_TOKEN=
