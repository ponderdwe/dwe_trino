{
  "environment": "prod",
  "files": [
    {
      "type": "properties",
      "path": "trino/coordinator-config.properties",
      "properties": {
        "coordinator": "true",
        "node-scheduler.include-coordinator": "false",
        "http-server.http.port": "8080",
        "discovery-server.enabled": "true",
        "discovery.uri": "http://trino:8080",
        "http-server.authentication.type": "PASSWORD",
        "internal-communication.https.required": "false",
        "internal-communication.shared-secret": "${TRINO_SHARED_SECRET}",
        "http-server.process-forwarded": "true"
      }
    },
    {
      "type": "properties",
      "path": "trino/worker-config.properties",
      "properties": {
        "coordinator": "false",
        "http-server.http.port": "8080",
        "discovery.uri": "http://trino:8080",
        "http-server.authentication.type": "PASSWORD",
        "internal-communication.https.required": "false",
        "internal-communication.shared-secret": "${TRINO_SHARED_SECRET}",
        "http-server.process-forwarded": "true"
      }
    },
    {
      "type": "properties",
      "path": "trino/trino_connections/iceberg.properties",
      "properties": {
        "connector.name": "iceberg",
        "iceberg.catalog.type": "nessie",
        "iceberg.nessie-catalog.uri": "${CATALOG_URL}/api/v1",
        "iceberg.nessie-catalog.default-warehouse-dir": "${ICEBERG_WAREHOUSE_DIR}",
        "iceberg.nessie-catalog.ref": "main",
        "fs.native-azure.enabled": "true",
        "azure.auth-type": "ACCESS_KEY",
        "azure.access-key": "${AZURE_STORAGE_KEY}"
      }
    },
    {
      "type": "properties",
      "path": "trino/trino_connections/duckdb.properties",
      "properties": {
        "connector.name": "duckdb",
        "connection-url": "jdbc:duckdb:/data/duckdb/local.db"
      }
    },
    {
      "type": "db",
      "path": "trino/password.db",
      "username_var": "TRINO_USER",
      "password_var": "TRINO_PASSWORD"
    }
  ]
}
